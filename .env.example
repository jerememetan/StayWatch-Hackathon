# .env or .env.local are loaded by Next.js. Do not commit either file.
# Without OPENAI_API_KEY, investigations run offline without external calls.
OPENAI_API_KEY=
EXA_API_KEY=
# Optional model override. The model must support Responses function calls.
OPENAI_MODEL=gpt-4.1-mini
# Optional room-photo model. Must support image input and structured outputs.
OPENAI_VISION_MODEL=gpt-4.1-mini
